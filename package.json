{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "format": "oxfmt",
    "test": "node --test tests/*.test.cjs",
    "check": "tsc --noEmit",
    "android:sync": "npm run build && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:verify": "node scripts/verify-android.mjs",
    "android:apk": "powershell -NoProfile -File scripts/build-trial.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@google/genai": "^2.31.0",
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}